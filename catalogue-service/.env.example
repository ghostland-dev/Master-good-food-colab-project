# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

PORT=3002
DATABASE_URL="mongodb+srv://root:randompassword@mongodb-service/cataloguedb?retryWrites=true&w=majority"

# MongoDB configuration
# MongoDB configuration
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=randompassword
MONGO_INITDB_DATABASE=cataloguedb

# Message Broker configuration
RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=password
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_HOST=rabbitmq-service
RABBITMQ_PORT=5672

# config for the queue
QUEUE_NAME=catalogue-service
EXCHANGE_NAME=amq.direct
ROUTING_KEY=catalogue-service

